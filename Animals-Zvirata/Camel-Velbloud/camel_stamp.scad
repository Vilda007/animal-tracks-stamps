module base_shape() {
    // convex base around the track.
    // "hull": convex hull of the track + base_margin (default, always safe)
    // "ellipse" / "circle": circumscribed ellipse/circle
    if (base_shape == "circle")
        circle(r = max(base_rx, base_ry), $fn = 128);
    else if (base_shape == "ellipse")
        scale([base_rx, base_ry]) circle(r = 1, $fn = 128);
    else
        offset(r = base_margin) hull() footprint();
}

module stamp_body() {
    mirror(side == "R" ? [1, 0, 0] : [0, 0, 0])
    union() {
        relief();
        linear_extrude(base_h) base_shape();
    }
    translate([0, 0, base_h - 1.0])
    linear_extrude(handle_h + 1.0)
        offset(r = handle_r) offset(delta = -handle_r)
            square([handle_w, handle_d], center = true);
}

module top_text() {
    translate([0, 0, base_h + handle_h - 0.5])
    linear_extrude(text_h + 0.5)
    union() {
        translate([0, 3.30, 0])
            text(name_cz, size = 6.40, halign = "center",
                 font = "Liberation Sans:style=Bold");
        translate([0, -3.90, 0])
            text(name_en, size = 5.00, halign = "center",
                 font = "Liberation Sans:style=Bold");
        translate([0, -9.00, 0])
            text(side, size = 6.40, halign = "center",
                 font = "Liberation Sans:style=Bold");
    }
}

union() {
    stamp_body();
    top_text();
}
